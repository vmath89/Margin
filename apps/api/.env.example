# Local paths and database behavior. Relative paths resolve from the repository root.
MARGIN_DATA_ROOT=var
MARGIN_DATABASE_URL=sqlite:///var/margin.db
MARGIN_DATABASE_ECHO=false

# OpenRouter credentials remain backend-only. The API can start without a key; a future
# provider-backed feature will fail with a configuration error until this is populated.
OPENROUTER_API_KEY=
OPENROUTER_REASONING_MODEL=openai/gpt-5.6-sol
OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2
OPENROUTER_TTS_VOICE=en-US-Harper:MAI-Voice-2

# Recording and deterministic context-budget inputs selected by the M1 spikes.
MARGIN_MAX_RECORDING_SECONDS=120
MARGIN_MAX_QUESTION_CHARACTERS=2000
MARGIN_CONTEXT_BUDGET_MODE=token
MARGIN_MODEL_CONTEXT_LIMIT=128000
MARGIN_RESERVED_ANSWER_TOKENS=4096
MARGIN_CONTEXT_SAFETY_MARGIN=2048
MARGIN_TOKENIZER_ENCODING=o200k_base
MARGIN_REQUEST_FRAMING_TOKENS=4
MARGIN_CONSERVATIVE_CHARACTERS_PER_TOKEN=3.0

# Every synthesis input below participates in the derived audio-cache version.
MARGIN_TTS_CONTRACT_VERSION=openrouter-audio-speech-v1
MARGIN_TTS_RESPONSE_FORMAT=mp3
MARGIN_TTS_SPEED=1.0
# MARGIN_TTS_STYLE=
# MARGIN_TTS_STYLE_DEGREE=
